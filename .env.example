# ==============================================================================
# Fynvi Share — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure the values for your deployment.
# Do NOT commit real passwords or production secrets into version control.
# ==============================================================================

# Port on which the application is exposed (default: 3000)
PORT=3000

# Backend internal port (default: 8080)
BACKEND_PORT=8080

# Public URL where the application is accessible
APP_URL=http://localhost:3000

# Directory where uploaded files and database are stored
DATA_DIRECTORY=./data

# Database connection URL (defaults to fynvi-share.db inside the data directory)
# Existing Pingvin Share X installations keep using pingvin-share.db automatically.
DATABASE_URL=file:../data/fynvi-share.db

# Set to true when running behind a reverse proxy (e.g. Nginx, Traefik, Caddy, Cloudflare)
TRUST_PROXY=false

# Optional: Path to custom YAML configuration file (e.g., config.yaml)
# CONFIG_FILE=./config.yaml

# Optional: Logging level (verbose, debug, log, warn, error, fatal)
# FS_LOG_LEVEL=log
# PV_LOG_LEVEL remains supported for existing Pingvin Share X configurations.

# Optional: ClamAV virus scanner host and port (if enabled)
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
